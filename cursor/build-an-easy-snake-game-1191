(cd "$(git rev-parse --show-toplevel)" && git apply --3way <<'EOF'
diff --git a/snake_game.html b/snake_game.html
--- a/snake_game.html
+++ b/snake_game.html
@@ -0,0 +1,330 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Snake Game</title>
+    <style>
+        * {
+            margin: 0;
+            padding: 0;
+            box-sizing: border-box;
+        }
+
+        body {
+            display: flex;
+            flex-direction: column;
+            justify-content: center;
+            align-items: center;
+            min-height: 100vh;
+            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
+            font-family: 'Arial', sans-serif;
+        }
+
+        .game-container {
+            text-align: center;
+            background: rgba(255, 255, 255, 0.95);
+            padding: 30px;
+            border-radius: 20px;
+            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
+        }
+
+        h1 {
+            color: #333;
+            margin-bottom: 10px;
+            font-size: 2.5em;
+        }
+
+        .info-panel {
+            display: flex;
+            justify-content: space-around;
+            margin: 20px 0;
+            font-size: 1.2em;
+            color: #555;
+        }
+
+        .score, .high-score {
+            font-weight: bold;
+        }
+
+        canvas {
+            border: 4px solid #333;
+            border-radius: 10px;
+            background: #f0f0f0;
+            display: block;
+            margin: 0 auto;
+        }
+
+        .controls {
+            margin-top: 20px;
+            color: #555;
+        }
+
+        .btn {
+            margin-top: 15px;
+            padding: 12px 30px;
+            font-size: 1.1em;
+            background: #667eea;
+            color: white;
+            border: none;
+            border-radius: 8px;
+            cursor: pointer;
+            transition: all 0.3s;
+        }
+
+        .btn:hover {
+            background: #764ba2;
+            transform: scale(1.05);
+        }
+
+        .game-over {
+            display: none;
+            color: #e74c3c;
+            font-size: 1.5em;
+            font-weight: bold;
+            margin: 10px 0;
+        }
+
+        .instructions {
+            margin-top: 15px;
+            padding: 15px;
+            background: #f8f9fa;
+            border-radius: 8px;
+            color: #666;
+            font-size: 0.9em;
+        }
+    </style>
+</head>
+<body>
+    <div class="game-container">
+        <h1>🐍 Snake Game</h1>
+        
+        <div class="info-panel">
+            <div class="score">Score: <span id="score">0</span></div>
+            <div class="high-score">High Score: <span id="highScore">0</span></div>
+        </div>
+
+        <canvas id="gameCanvas" width="400" height="400"></canvas>
+        
+        <div class="game-over" id="gameOver">
+            Game Over! 💀
+        </div>
+
+        <button class="btn" id="startBtn" onclick="startGame()">Start Game</button>
+
+        <div class="instructions">
+            <strong>How to Play:</strong><br>
+            Use Arrow Keys (↑ ↓ ← →) to move the snake<br>
+            Eat the red food to grow and score points<br>
+            Don't hit the walls or yourself!
+        </div>
+    </div>
+
+    <script>
+        const canvas = document.getElementById('gameCanvas');
+        const ctx = canvas.getContext('2d');
+        const scoreElement = document.getElementById('score');
+        const highScoreElement = document.getElementById('highScore');
+        const gameOverElement = document.getElementById('gameOver');
+        const startBtn = document.getElementById('startBtn');
+
+        // Game settings
+        const gridSize = 20;
+        const tileCount = canvas.width / gridSize;
+
+        // Game state
+        let snake = [{ x: 10, y: 10 }];
+        let food = { x: 15, y: 15 };
+        let dx = 0;
+        let dy = 0;
+        let score = 0;
+        let highScore = localStorage.getItem('snakeHighScore') || 0;
+        let gameLoop;
+        let gameStarted = false;
+
+        highScoreElement.textContent = highScore;
+
+        // Keyboard controls
+        document.addEventListener('keydown', changeDirection);
+
+        function changeDirection(event) {
+            const key = event.keyCode;
+            const goingUp = dy === -1;
+            const goingDown = dy === 1;
+            const goingRight = dx === 1;
+            const goingLeft = dx === -1;
+
+            if (key === 37 && !goingRight) { // Left arrow
+                dx = -1;
+                dy = 0;
+            }
+            if (key === 38 && !goingDown) { // Up arrow
+                dx = 0;
+                dy = -1;
+            }
+            if (key === 39 && !goingLeft) { // Right arrow
+                dx = 1;
+                dy = 0;
+            }
+            if (key === 40 && !goingUp) { // Down arrow
+                dx = 0;
+                dy = 1;
+            }
+        }
+
+        function startGame() {
+            if (gameStarted) {
+                resetGame();
+            }
+            
+            gameStarted = true;
+            gameOverElement.style.display = 'none';
+            startBtn.textContent = 'Restart Game';
+            
+            snake = [{ x: 10, y: 10 }];
+            dx = 1;
+            dy = 0;
+            score = 0;
+            scoreElement.textContent = score;
+            generateFood();
+            
+            clearInterval(gameLoop);
+            gameLoop = setInterval(update, 100);
+        }
+
+        function resetGame() {
+            clearInterval(gameLoop);
+            gameStarted = false;
+        }
+
+        function update() {
+            // Move snake
+            const head = { x: snake[0].x + dx, y: snake[0].y + dy };
+
+            // Check wall collision
+            if (head.x < 0 || head.x >= tileCount || head.y < 0 || head.y >= tileCount) {
+                gameOver();
+                return;
+            }
+
+            // Check self collision
+            for (let i = 0; i < snake.length; i++) {
+                if (head.x === snake[i].x && head.y === snake[i].y) {
+                    gameOver();
+                    return;
+                }
+            }
+
+            snake.unshift(head);
+
+            // Check food collision
+            if (head.x === food.x && head.y === food.y) {
+                score += 10;
+                scoreElement.textContent = score;
+                generateFood();
+                
+                // Update high score
+                if (score > highScore) {
+                    highScore = score;
+                    highScoreElement.textContent = highScore;
+                    localStorage.setItem('snakeHighScore', highScore);
+                }
+            } else {
+                snake.pop();
+            }
+
+            draw();
+        }
+
+        function generateFood() {
+            food.x = Math.floor(Math.random() * tileCount);
+            food.y = Math.floor(Math.random() * tileCount);
+
+            // Make sure food doesn't spawn on snake
+            for (let i = 0; i < snake.length; i++) {
+                if (food.x === snake[i].x && food.y === snake[i].y) {
+                    generateFood();
+                    return;
+                }
+            }
+        }
+
+        function draw() {
+            // Clear canvas
+            ctx.fillStyle = '#f0f0f0';
+            ctx.fillRect(0, 0, canvas.width, canvas.height);
+
+            // Draw grid (optional)
+            ctx.strokeStyle = '#ddd';
+            ctx.lineWidth = 0.5;
+            for (let i = 0; i <= tileCount; i++) {
+                ctx.beginPath();
+                ctx.moveTo(i * gridSize, 0);
+                ctx.lineTo(i * gridSize, canvas.height);
+                ctx.stroke();
+                
+                ctx.beginPath();
+                ctx.moveTo(0, i * gridSize);
+                ctx.lineTo(canvas.width, i * gridSize);
+                ctx.stroke();
+            }
+
+            // Draw snake
+            for (let i = 0; i < snake.length; i++) {
+                ctx.fillStyle = i === 0 ? '#2ecc71' : '#27ae60';
+                ctx.fillRect(
+                    snake[i].x * gridSize + 1,
+                    snake[i].y * gridSize + 1,
+                    gridSize - 2,
+                    gridSize - 2
+                );
+                
+                // Draw eyes on head
+                if (i === 0) {
+                    ctx.fillStyle = 'white';
+                    const eyeSize = 4;
+                    const eyeOffset = 5;
+                    
+                    // Draw eyes based on direction
+                    if (dx === 1) { // Right
+                        ctx.fillRect(snake[i].x * gridSize + gridSize - eyeOffset, snake[i].y * gridSize + 4, eyeSize, eyeSize);
+                        ctx.fillRect(snake[i].x * gridSize + gridSize - eyeOffset, snake[i].y * gridSize + 12, eyeSize, eyeSize);
+                    } else if (dx === -1) { // Left
+                        ctx.fillRect(snake[i].x * gridSize + 3, snake[i].y * gridSize + 4, eyeSize, eyeSize);
+                        ctx.fillRect(snake[i].x * gridSize + 3, snake[i].y * gridSize + 12, eyeSize, eyeSize);
+                    } else if (dy === -1) { // Up
+                        ctx.fillRect(snake[i].x * gridSize + 4, snake[i].y * gridSize + 3, eyeSize, eyeSize);
+                        ctx.fillRect(snake[i].x * gridSize + 12, snake[i].y * gridSize + 3, eyeSize, eyeSize);
+                    } else if (dy === 1) { // Down
+                        ctx.fillRect(snake[i].x * gridSize + 4, snake[i].y * gridSize + gridSize - eyeOffset, eyeSize, eyeSize);
+                        ctx.fillRect(snake[i].x * gridSize + 12, snake[i].y * gridSize + gridSize - eyeOffset, eyeSize, eyeSize);
+                    }
+                }
+            }
+
+            // Draw food
+            ctx.fillStyle = '#e74c3c';
+            ctx.beginPath();
+            ctx.arc(
+                food.x * gridSize + gridSize / 2,
+                food.y * gridSize + gridSize / 2,
+                gridSize / 2 - 2,
+                0,
+                Math.PI * 2
+            );
+            ctx.fill();
+        }
+
+        function gameOver() {
+            clearInterval(gameLoop);
+            gameOverElement.style.display = 'block';
+            startBtn.textContent = 'Play Again';
+            gameStarted = false;
+        }
+
+        // Initial draw
+        draw();
+    </script>
+</body>
+</html>
+
EOF
)
